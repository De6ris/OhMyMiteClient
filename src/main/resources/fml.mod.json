{
  "schemaVersion": 1,
  "id": "ommc",
  "version": "${version}",
  "depends": {
    "fishmodloader": ">=3.4.1",
    "many-lib": ">=2.2.1",
    "rusted_iron_core": "*"
  },
  "environment": "client",
  "name": "OhMyMiteClient",
  "description": "Some useful cheating tweaks\n一些有用的作弊功能",
  "icon": "assets/ommc/icon.png",
  "authors": [
    "Debris"
  ],
  "entrypoints": {
    "client": [
      "com.github.debris.ommc.OhMyMiteClient"
    ],
    "modmenu": [
      "com.github.debris.ommc.integration.ModMenuImpl"
    ]
  },
  "mixins": [
    "OhMyMiteClient.mixins.json"
  ],
  "accessWidener": "OhMyMiteClient.accesswidener",
  "custom": {
    "modmenu": {
      "clientsideOnly": true
    }
  }
}